<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>vault</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#0a0a00</string>
				<key>foreground</key>
				<string>#c8b400</string>
				<key>caret</key>
				<string>#c8b400</string>
				<key>selection</key>
				<string>#2a3a00</string>
				<key>lineHighlight</key>
				<string>#141400</string>
				<key>inactiveSelection</key>
				<string>#1a1a00</string>
			</dict>
		</dict>

		<!-- 注释：乳白斜体 -->
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#f7f0c8</string>
				<key>fontStyle</key>
				<string>italic</string>
			</dict>
		</dict>

		<!-- 字符串：浅牛油果绿 -->
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#a3c47a</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>String Escape</string>
			<key>scope</key>
			<string>constant.character.escape</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#88b04b</string>
			</dict>
		</dict>

		<!-- 关键字 / 存储：牛油果绿 -->
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword, storage, storage.type</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#88b04b</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Keyword Control</string>
			<key>scope</key>
			<string>keyword.control, keyword.operator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#c87000</string>
			</dict>
		</dict>

		<!-- 数字 / 常量：亮琥珀 -->
		<dict>
			<key>name</key>
			<string>Number</string>
			<key>scope</key>
			<string>constant.numeric, constant.language, constant.character, constant.other</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#e8d400</string>
			</dict>
		</dict>

		<!-- 函数 / 支持：info 绿 -->
		<dict>
			<key>name</key>
			<string>Function</string>
			<key>scope</key>
			<string>entity.name.function, support.function, support.class, support.module</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#7aaa00</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Type</string>
			<key>scope</key>
			<string>entity.name.type, support.type, entity.other.inherited-class</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#7aaa00</string>
			</dict>
		</dict>

		<!-- 变量：主前景琥珀 -->
		<dict>
			<key>name</key>
			<string>Variable</string>
			<key>scope</key>
			<string>variable, variable.other, variable.parameter, meta.definition.variable</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#c8b400</string>
			</dict>
		</dict>

		<!-- 预处理器：暗琥珀 -->
		<dict>
			<key>name</key>
			<string>Preprocessor</string>
			<key>scope</key>
			<string>meta.preprocessor, keyword.control.directive, comment.block.documentation</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#5a5200</string>
			</dict>
		</dict>

		<!-- 运算符 / 标点 -->
		<dict>
			<key>name</key>
			<string>Operator</string>
			<key>scope</key>
			<string>keyword.operator, punctuation.separator, punctuation.accessor</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#c8b400</string>
			</dict>
		</dict>

		<!-- 错误 -->
		<dict>
			<key>name</key>
			<string>Invalid</string>
			<key>scope</key>
