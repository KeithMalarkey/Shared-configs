		<dict>
			<key>name</key>
			<string>Markup Raw</string>
			<key>scope</key>
			<string>markup.raw, markup.inserted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#88b04b</string>
			</dict>
		</dict>

		<!-- 链接 -->
		<dict>
			<key>name</key>
			<string>Markup Underline</string>
			<key>scope</key>
			<string>markup.underline, underline.link</string>
